{
  "name": "technolife/data-studio-instance-api",
  "description": "Backend da Instance do Technolife Data Studio.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Technolife\\DataStudio\\Instance\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Technolife\\DataStudio\\Instance\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "analyse": "phpstan analyse src tests --level=8 --no-progress"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
